# --- Used by the deployed static site (baked into the build, public) ---
# Supabase (Project Settings -> API). The anon key is safe to ship to the
# browser — every table it can touch is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Geoapify (geoapify.com, free tier) - powers the shared map tile style
# (Public Map, Admin Map Studio, Event Zone Editor). Domain-restricted like
# the Supabase anon key above, safe to ship to the browser.
NEXT_PUBLIC_GEOAPIFY_API_KEY=your-geoapify-api-key

# --- Used only by local scripts (scripts/seed-lov.ts, scripts/geocode-lov.ts) ---
# Never shipped to the browser — keep this out of any deployed bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
