{
  "name": "citypinned-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "esbuild worker/index.ts --bundle --format=esm --target=es2022 --outfile=out/_worker.js",
    "preview": "npx serve out",
    "lint": "eslint",
    "seed:lov": "tsx scripts/seed-lov.ts",
    "geocode:lov": "tsx scripts/geocode-lov.ts",
    "deploy": "npm run build && npm run build:worker && wrangler pages deploy out --project-name=citypinned-v2-check --commit-dirty=true",
    "deploy:workers-dev-legacy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "next": "16.2.12",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "wrangler": "^4.115.0"
  }
}
