{
  // "npx wrangler deploy" still serves the static export as before, but
  // now runs through worker/index.ts first - it handles two JSON API
  // routes (Stripe Checkout Session creation + webhook) and falls through
  // to the ASSETS binding (unchanged static-file serving) for everything
  // else, so no other page/route's behavior changes.
  "name": "beta-v2",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-26",
  "assets": {
    "directory": "out",
    "binding": "ASSETS"
  }
}
