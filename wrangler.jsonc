{
  // Tells Wrangler's unified `wrangler deploy` command this is a Cloudflare
  // Workers with static assets project (built by `npm run build` into out/),
  // not a plain Worker script — this tells it where to find the assets.
  "name": "beta-v2",
  "compatibility_date": "2024-07-26",
  "assets": {
    "directory": "out"
  }
}
