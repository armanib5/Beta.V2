{
  // Tells Wrangler's unified `wrangler deploy` command this is a Cloudflare
  // Pages static-asset project (built by `npm run build` into out/), not a
  // Worker script — without this, `wrangler deploy` has no way to know
  // where the static export lives and fails trying to process it as one.
  "pages_build_output_dir": "out"
}
